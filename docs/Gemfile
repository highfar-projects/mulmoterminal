source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "just-the-docs", "~> 0.10"
# Without it the guide ships no sitemap, and a search engine has to find 95 pages by
# crawling alone. jekyll-seo-tag comes with the theme; naming it keeps the `plugins:`
# list in _config.yml from being the only place it is declared.
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-seo-tag", "~> 2.8"
